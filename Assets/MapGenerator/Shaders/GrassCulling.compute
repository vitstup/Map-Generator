#pragma kernel Generate
#pragma kernel Cull
#pragma kernel FrameArguments
#pragma kernel PrepareFrame
#include "GrassCommon.hlsl"
#include "GrassFlowers.hlsl"
struct GrassInstance { float4 positionHeight; float4 variation; };
RWStructuredBuffer<GrassInstance> _Instances;
StructuredBuffer<uint> _ActiveSlots;
AppendStructuredBuffer<uint> _Near;
AppendStructuredBuffer<uint> _Middle;
AppendStructuredBuffer<uint> _Heads;
AppendStructuredBuffer<uint> _Sparse;
int _Optimization;
Texture2D<float> _Height0, _Height1, _Height2;
Texture2D<float4> _Coverage0, _Coverage1, _Coverage2;
Texture2D<float> _Holes0, _Holes1, _Holes2;
SamplerState sampler_linear_clamp;
float4 _Rect0, _Rect1, _Rect2, _Vertical0, _Vertical1, _Vertical2;
float4 _ChunkOrigin, _HeightRange, _PlantRules, _Camera, _Lod, _Projection;
float4 _Planes[6];
float4 _Focus;
float4 _MeadowRange;
uint _Pool;
int _TopologyCheck;
int _TransitionCheck;
int _ReferenceGeometry;
uint _Axis, _PerSlot, _Slot, _ActiveCount;
float _ChunkSize;
RWStructuredBuffer<uint4> _Prepared;
StructuredBuffer<uint> _FrameNear, _FrameMiddle, _FrameSparse;
RWByteAddressBuffer _FrameCounts;
RWBuffer<uint> _FrameDispatch;
float4 _FrameWind, _FrameMeadow, _FrameDry, _FrameNearRange;

[numthreads(1,1,1)]
void FrameArguments(uint3 dispatch:SV_DispatchThreadID)
{
    uint count=_FrameCounts.Load(0)+_FrameCounts.Load(4)+_FrameCounts.Load(8);
    _FrameDispatch[0]=max(1u,(count+63)/64);
    _FrameDispatch[1]=1;
    _FrameDispatch[2]=1;
}
[numthreads(64,1,1)]
void PrepareFrame(uint3 dispatch:SV_DispatchThreadID)
{
    uint n=_FrameCounts.Load(0),m=_FrameCounts.Load(4),count=n+m+_FrameCounts.Load(8),i=dispatch.x;
    if(i>=count)return;
    uint index=i<n?_FrameNear[i]:i<n+m?_FrameMiddle[i-n]:_FrameSparse[i-n-m];
    GrassInstance instance=_Instances[index];float2 anchor=instance.positionHeight.xz;
    float cluster=GrassNoise(anchor/2.3+_FrameWind.z*.01);
    uint family=cluster<.33?0:cluster<.66?1:2;
    float3 palette=GrassPalette(anchor,instance.variation.y,_FrameWind.z,_FrameMeadow.rgb,_FrameDry.rgb);
    float viewDepth=max(.1,distance(instance.positionHeight.xyz,_Camera.xyz));
    float pixels=(_Pool==0?instance.positionHeight.w:2.8)*_Projection.x/(_Projection.y>.5?1:viewDepth);
    float detail=GrassDetailWeight(pixels/GrassLodBias(anchor,_FrameWind.z));
    float near=(_TransitionCheck&1)==0?GrassHandoffFade(anchor,_Focus.xz,_FrameNearRange.x,_FrameNearRange.y,_FrameWind.z):GrassFieldFade(anchor,_Focus.xz,_FrameNearRange.x,_FrameNearRange.y,_FrameWind.z);
    // Binary16 is sufficient for colors and bounded morph weights. Keep wind as float32
    // so flowers and stems use the exact same gust even during a close camera flight.
    _Prepared[index]=uint4(f32tof16(palette.r)|(f32tof16(palette.g)<<16),
        f32tof16(palette.b)|(f32tof16(detail)<<16),asuint(GrassGust(anchor,_FrameWind.x,_FrameWind.y)),f32tof16(near)|(family<<16));
}

bool Contains(float2 p, float4 rect) { return all(p >= rect.xy) && all(p < rect.xy + rect.zw); }
float4 CoverageAt(int level,float2 uv)
{
    return level==0?_Coverage0.SampleLevel(sampler_linear_clamp,uv,0):
           level==1?_Coverage1.SampleLevel(sampler_linear_clamp,uv,0):_Coverage2.SampleLevel(sampler_linear_clamp,uv,0);
}
float HeightAt(int level, float2 uv)
{
    float4 vertical = level == 0 ? _Vertical0 : level == 1 ? _Vertical1 : _Vertical2;
    // Terrain heightmaps store the normalized height in [0, 0.5]. Texel-centred UVs match SetHeights.
    uv = (uv * (vertical.z - 1) + .5) / vertical.z;
    float h = level == 0 ? _Height0.SampleLevel(sampler_linear_clamp, uv, 0) :
              level == 1 ? _Height1.SampleLevel(sampler_linear_clamp, uv, 0) : _Height2.SampleLevel(sampler_linear_clamp, uv, 0);
    return vertical.x + h * 2 * vertical.y;
}
[numthreads(64,1,1)]
void Generate(uint3 dispatch : SV_DispatchThreadID)
{
    uint i = dispatch.x; if (i >= _PerSlot) return;
    float2 lattice = float2(i % _Axis, i / _Axis);
    float2 key = _ChunkOrigin.xy + lattice * (_ChunkSize / _Axis);
    float random = GrassHash(key + _PlantRules.w);
    float2 jitter = float2(random, GrassHash(key + 47.17 + _PlantRules.w));
    float2 world = _ChunkOrigin.xy + (lattice + .1 + jitter * .8) * (_ChunkSize / _Axis);
    GrassInstance instance = (GrassInstance)0;
    int level = Contains(world, _Rect0) ? 0 : Contains(world, _Rect1) ? 1 : Contains(world, _Rect2) ? 2 : -1;
    if (level >= 0)
    {
        float4 rect = level == 0 ? _Rect0 : level == 1 ? _Rect1 : _Rect2;
        float2 uv = (world - rect.xy) / rect.zw;
        float4 cover=CoverageAt(level,uv);
        float hole = level == 0 ? _Holes0.SampleLevel(sampler_linear_clamp, uv, 0) :
                     level == 1 ? _Holes1.SampleLevel(sampler_linear_clamp, uv, 0) : _Holes2.SampleLevel(sampler_linear_clamp, uv, 0);
        float height = HeightAt(level, uv);
        float stepSize = .75;
        float gx = (HeightAt(level, uv + float2(stepSize / rect.z, 0)) - HeightAt(level, uv - float2(stepSize / rect.z, 0))) / (2 * stepSize);
        float gz = (HeightAt(level, uv + float2(0, stepSize / rect.w)) - HeightAt(level, uv - float2(0, stepSize / rect.w))) / (2 * stepSize);
        float slope = rsqrt(1 + gx * gx + gz * gz);
        float suitability = smoothstep(_PlantRules.y, min(1, _PlantRules.y + .08), slope) * smoothstep(_PlantRules.z, _PlantRules.z + 1.2, height);
        float probability = saturate(cover.r*1.45) * cover.a * GrassPermission(cover.b) * GrassPatch(world, _PlantRules.w) * _PlantRules.x * suitability;
        float pick = GrassHash(key + 191.7 + _PlantRules.w);
        if (pick < probability && hole > .5)
        {
            float h = lerp(_HeightRange.x, _HeightRange.y, random) * lerp(.8, 1.2, GrassNoise(world / 7 + _PlantRules.w));
            if (_Pool == 1) h=lerp(.16,.28,random);
            if (_Pool == 2) h=lerp(.8,1.15,random);
            instance.positionHeight = float4(world.x, height - .035, world.y, h);
            // Root permission is invariant in the interior of a meadow. Classify the entire
            // footprint once at generation time, avoiding texture fetches per vertex per frame.
            float2 extent=(_Pool==0?.65:_Pool==1?2.6:3.5)/rect.zw;
            float4 a=CoverageAt(level,uv+float2(extent.x,0));
            float4 b=CoverageAt(level,uv-float2(extent.x,0));
            float4 c=CoverageAt(level,uv+float2(0,extent.y));
            float4 e=CoverageAt(level,uv-float2(0,extent.y));
            float4 f=CoverageAt(level,uv+extent),g=CoverageAt(level,uv-extent);
            float4 j=CoverageAt(level,uv+float2(extent.x,-extent.y)),k=CoverageAt(level,uv+float2(-extent.x,extent.y));
            float maxSand=max(cover.b,max(max(a.b,b.b),max(c.b,e.b)));
            maxSand=max(maxSand,max(max(f.b,g.b),max(j.b,k.b)));
            float minPermission=min(cover.a,min(min(a.a,b.a),min(c.a,e.a)));
            minPermission=min(minPermission,min(min(f.a,g.a),min(j.a,k.a)));
            bool edge=maxSand>.001||minPermission<.999;
            edge=edge||any(uv<extent)||any(uv>1-extent);
            float rotation=random*6.283185;
            if(_Pool<2)
            {
                uint packed=(uint)round(random*511);
                if(_Pool==0)
                {
                    float2 site;
                    float2 cell=floor(world);
                    if(GrassFlowerSite(cell,_PlantRules.w,site)&&all(abs(floor(site*4)*.25-key)<.01))
                        packed|=(1u|((uint)GrassFlowerSpecies(site,_PlantRules.w)<<4))<<9;
                }
                else
                {
                    int heads=0;
                    float2 origin=floor(key);
                    [unroll]for(int z=0;z<3;z++)[unroll]for(int x=0;x<3;x++)
                    {
                        float2 site;
                        if(heads>=2||!GrassFlowerSite(origin+float2(x,z),_PlantRules.w,site))continue;
                        if(any(site<key)||any(site>=key+_ChunkSize/_Axis))continue;
                        uint code=(uint)(1+x+z*3)|((uint)GrassFlowerSpecies(site,_PlantRules.w)<<4);
                        packed|=code<<(heads==0?9:16);heads++;
                    }
                }
                rotation=asfloat(packed|0x3f000000u);
            }
            instance.variation = float4(rotation, cover.g, GrassHash(key + 89.4), edge?-probability:probability);
        }
    }
    _Instances[_Slot * _PerSlot + i] = instance;
}
[numthreads(64,1,1)]
void Cull(uint3 dispatch : SV_DispatchThreadID)
{
    uint i = dispatch.x; if (i >= _ActiveCount * _PerSlot) return;
    uint index = _ActiveSlots[i / _PerSlot] * _PerSlot + i % _PerSlot;
    GrassInstance instance = _Instances[index]; float height = instance.positionHeight.w;
    if (height <= 0) return;
    float3 center = instance.positionHeight.xyz + float3(0, height * .5, 0);
    float radius = _Pool == 0 ? height+1 : 3.5;
    // Include the longest low blade and the maximum current wind displacement.
    if(_Pool==0&&_ReferenceGeometry==0)radius=max(radius,.5+height*(2+1.5*_Projection.w));
    for (int p = 0; p < 6; p++) if (dot(_Planes[p].xyz, center) + _Planes[p].w < -radius) return;
    float d = distance(_Focus.xz, instance.positionHeight.xz);
    if (d >= _Lod.x) return;
    if((_TransitionCheck&1)!=0)
    {
        if (_Pool==2&&GrassFieldFade(instance.positionHeight.xz,_Focus.xz,_MeadowRange.x,_MeadowRange.y,_MeadowRange.z)>.999) return;
    }
    else
    {
        if(_Pool==2&&d+radius<_MeadowRange.w*.72*.82) return;
        // Bound the shared handoff field over the complete plant footprint. The maximum
        // gradient is .18 * 1.5 * sqrt(2) / 19 < .021 per metre, so no surviving pixel is lost.
        if(_ReferenceGeometry==0)
        {
            float bias=lerp(.82,1,GrassNoise(instance.positionHeight.xz/19+_PlantRules.w*.031));
            float outer=_Pool==1?_MeadowRange.w:_Lod.x;
            if(d-radius>outer*min(1,bias+.021*radius))return;
        }
    }
    float viewDepth=max(.1,distance(instance.positionHeight.xyz,_Camera.xyz));
    float pixels = (_Pool==0?height:2.8) * _Projection.x / (_Projection.y > .5 ? 1 : viewDepth);
    if (pixels <= _Lod.z) return;
    if(_Pool==1&&instance.variation.z>_Projection.z) return;
    if (_Pool==0)
    {
        float detailed=GrassDetailWeight(pixels/GrassLodBias(instance.positionHeight.xz,_PlantRules.w));
        if(_ReferenceGeometry!=0)detailed=smoothstep(4,7,pixels/GrassLodBias(instance.positionHeight.xz,_PlantRules.w)*1.5);
        // At zero morph the subdivided blade is exactly the single triangle. No double draw.
        if(_TopologyCheck==1||(_TopologyCheck==0&&detailed>0)) _Near.Append(index);
        else if(_ReferenceGeometry==0&&(_Optimization&1)!=0&&_TopologyCheck==0&&pixels/GrassLodBias(instance.positionHeight.xz,_PlantRules.w)<4.5) _Sparse.Append(index);
        else _Middle.Append(index);
    }
    else if(_Pool==1&&_ReferenceGeometry==0&&(_Optimization&2)!=0&&height*2.6*_Projection.x/(_Projection.y>.5?1:viewDepth)<3.5) _Sparse.Append(index);
    else _Middle.Append(index);
    if(_Pool<2&&_GrassFlowers.x>0&&_ReferenceGeometry==0)
    {
        uint packed=asuint(instance.variation.x);
        if(((packed>>9)&15u)!=0||(_Pool==1&&((packed>>16)&15u)!=0))_Heads.Append(index);
    }
}
