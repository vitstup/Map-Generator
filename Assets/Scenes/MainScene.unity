  m_text: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u0438\u043B\u0438 \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435
    \u0442\u043E\u0447\u043A\u0443 \u043D\u0430 \u043A\u0430\u0440\u0442\u0435.\n\u0420\u0430\u0434\u0438\u0443\u0441
    50 = \u043A\u0432\u0430\u0434\u0440\u0430\u0442 101 \xD7 101 \u0438\u0441\u0445\u043E\u0434\u043D\u044B\u0445
    \u043F\u0438\u043A\u0441\u0435\u043B\u0435\u0439.\n\u0417\u0430 \u0433\u0440\u0430\u043D\u0438\u0446\u0430\u043C\u0438
    \u0438\u0441\u0445\u043E\u0434\u043D\u043E\u0439 \u043A\u0430\u0440\u0442\u044B
    \u2014 \u0432\u043E\u0434\u0430."
